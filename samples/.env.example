# ----------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------
PORT=8181
NODE_ENV=development

# URLs for your frontend applications (used for CORS)
URL_CLIENT=http://localhost:3000
URL_CLIENT_MANAGEMENT=http://localhost:3001

# The base URL for this backend server
URL_SERVER=http://localhost:8080

# --- Middleware Configuration ---
CLIENT_ORIGIN=http://localhost:3000

# ----------------------------------------
# JWT (JSON WEB TOKEN) SECRETS
# ----------------------------------------
ACCESS_KEY=your_access_secret_here
REFRESH_KEY=your_refresh_secret_here
ACCESS_TIME=15m
REFRESH_TIME=7d

# ----------------------------------------
# EMAIL SERVICE (NODEMAILER WITH GMAIL)
# ----------------------------------------
EMAIL_APP=your_email_here@gmail.com
EMAIL_APP_PASSWORD=your_google_app_password

# ----------------------------------------
# CLOUDINARY (IMAGE STORAGE)
# ----------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----------------------------------------
# APPLICATION DEFAULTS
# ----------------------------------------
LIMIT_PRODUCT=12
LIMIT_MANAGE=10

# ----------------------------------------
# DATABASE (POSTGRESQL)
# ----------------------------------------
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_DATABASE=your_database_name
DB_HOST=localhost
DB_PORT=5433

# --- DATABASE_URL for Prisma ---
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@localhost:5432/${DB_DATABASE}?schema=public"

# ----------------------------------------
# VNPAY (PAYMENT GATEWAY) - Sandbox for testing
# ----------------------------------------
VNP_TMNCODE=your_vnpay_tmncode_from_sandbox
VNP_HASHSECRET=your_vnpay_hashsecret_from_sandbox
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURNURL=http://localhost:3000/payment-return

# ----------------------------------------
# SENDGRID WEB API CONFIGURATION
# ----------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM_NAME="Your Shop Name"
EMAIL_FROM_ADDRESS=your_email_here@gmail.com
